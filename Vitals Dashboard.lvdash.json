      "displayName": "Line Plots Aggregations",
      "queryLines": [
        "SELECT \r\n",
        "       \"GLOBAL\" as patient_id, \r\n",
        "       observation_date as report_day, \r\n",
        "       current_state,\r\n",
        "       pop_avg_hr as avg_bpm, \r\n",
        "       pop_avg_resp_rate as avg_resp_rate,\r\n",
        "       pop_avg_spo2 as avg_spo2,\r\n",
        "       observation_date as last_processed_at\r\n",
        "FROM global_vital_stats\r\n",
        "UNION\r\n",
        "SELECT * FROM Patient_daily_summary;"
      ],
      "catalog": "patient_data",
      "schema": "gold_patient_vitals"
    }
